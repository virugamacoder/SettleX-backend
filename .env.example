# ─────────────────────────────────────────────────────────────────────────────
#  SettleX Backend — Environment Variables
#  Copy this file to .env and fill in all required values.
#  NEVER commit the .env file to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────
# NODE_ENV options: production | development | test | local
NODE_ENV=production
PORT=3000
BASE_URL=https://yourdomain.com

# ── MongoDB ──────────────────────────────────────────────────────────────────
# MongoDB Atlas (cloud)
MONGODB_URL=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/<dbname>

# Local MongoDB (optional, only if self-hosted)
# DB_NAME=settlex
# DB_PORT=27017
# DB_SERVER=127.0.0.1
# DB_USER=
# DB_PASS=

# ── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_here_minimum_32_chars
JWT_ACCESS_EXPIRATION_MINUTES=30
JWT_REFRESH_EXPIRATION_DAYS=30

# ── CoinMarketCap ─────────────────────────────────────────────────────────────
COINMARKET_CAP_API_KEY=your_coinmarketcap_api_key_here

# ── SSL ───────────────────────────────────────────────────────────────────────
# Used ONLY when NODE_ENV=local (Docker/Nginx handles SSL in all other envs)
# Generate local certs with: bash deploy/generate-local-certs.sh
SSL_PRIV_KEY=./nginx/certs/private.key
SSL_FULLCHAIN_KEY=./nginx/certs/cert.pem

# ── Docker ────────────────────────────────────────────────────────────────────
# Docker Hub image name (used by docker-compose.yml on the EC2 server)
# Format: <your-dockerhub-username>/settlex-backend:latest
DOCKER_IMAGE=yourdockerhubusername/settlex-backend:latest
