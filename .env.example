# ─────────────────────────────────────────────────────────────────
#  SettleX Backend — Environment Variables
#  Copy this file to .env and fill in all required values.
#  NEVER commit the .env file to git.
# ─────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────
NODE_ENV=production           # production | development | test
PORT=3000
BASE_URL=https://yourdomain.com

# ── MongoDB ──────────────────────────────────────────────────────
MONGODB_URL=mongodb://localhost:27017/settlex
DB_NAME=settlex
DB_PORT=27017
DB_SERVER=localhost
DB_USER=
DB_PASS=

# ── JWT ──────────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_here
JWT_ACCESS_EXPIRATION_MINUTES=30
JWT_REFRESH_EXPIRATION_DAYS=30

# ── SSL ─────────────────────────────────────────────────────────
# For LOCAL dev (NODE_ENV=local): generate certs with:
#   openssl req -x509 -newkey rsa:4096 -nodes \
#     -keyout nginx/certs/private.key \
#     -out nginx/certs/cert.pem \
#     -days 365
# For EC2/production: leave blank (Nginx handles SSL via Let's Encrypt)
SSL_PRIV_KEY=./nginx/certs/private.key
SSL_FULLCHAIN_KEY=./nginx/certs/cert.pem

# ── CoinMarketCap ────────────────────────────────────────────────
COINMARKET_CAP_API_KEY=your_coinmarketcap_api_key_here
